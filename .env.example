# ─────────────────────────────────────────────────────────────
# 지사네 환경변수 템플릿
# ─────────────────────────────────────────────────────────────
# 사용법: 각 앱 루트(apps/admin · apps/owner · apps/expert)에 `.env.local`로 복사 후 값 채우기.
#   cp .env.example apps/owner/.env.local
# 실제 값(시크릿)은 절대 커밋 금지. 이 파일은 "무엇이 필요한지"만 문서화한다.
# 코드가 실제 읽는 변수 전수(2026-08-07 grep 기준). 미설정 시 대부분 런타임 throw.
#
# 표기: [필수] 없으면 동작 불가 · [공개] NEXT_PUBLIC_ = 빌드타임 주입·브라우저 노출(시크릿 금지)

# ── Supabase (전 앱 필수) ────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=            # [필수][공개] 예: https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= # [필수][공개] anon/publishable 키
SUPABASE_SECRET_KEY=                 # [필수] service_role 키 — 서버 전용, RLS 우회. 절대 클라이언트 노출 금지

# ── 사이트/도메인 ────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=                # [필수][공개] 해당 앱의 공개 오리진. 예: https://owner.jisane.cloud (로컬: http://localhost:3000)
                                     #   → OAuth 콜백·토스 successUrl/failUrl 조립에 사용. 미설정 시 결제/로그인 깨짐
NEXT_PUBLIC_ADMIN_URL=               # [공개] 크로스링크용 admin 앱 URL. 예: https://jisane.cloud
NEXT_PUBLIC_OWNER_URL=               # [공개] owner 앱 URL. 예: https://owner.jisane.cloud
NEXT_PUBLIC_EXPERT_URL=              # [공개] expert 앱 URL. 예: https://expert.jisane.cloud
COOKIE_DOMAIN=                       # 프로덕션 쿠키 도메인. 예: .jisane.cloud (로컬/프리뷰는 비워둠)

# ── 관리자/운영 ──────────────────────────────────────────────
ADMIN_EMAILS=                        # [필수] admin 접근 허용 이메일(콤마 구분). 예: a@x.com,b@y.com
ADMIN_SECRET=                        # [필수] 정산 해제/환불 등 운영 API 헤더 시크릿(x-admin-secret)
CRON_SECRET=                         # [필수] 크론 라우트 인증 시크릿

# ── 토스페이먼츠 (결제) ──────────────────────────────────────
# 키 발급: 토스페이먼츠 전자결제 신청 후 대시보드에서 확인. test 키는 즉시 발급, live 키는 계약 승인 후.
# test↔live 전환 = 값만 교체(코드 변경 불필요). test/live 키를 섞으면 INVALID_API_KEY.
TOSS_SECRET_KEY=                     # [필수] 서버 결제승인/취소 인증. test_sk_... 또는 live_sk_...
TOSS_WEBHOOK_SECRET=                 # [필수] 웹훅 HMAC 서명검증. 토스 대시보드 웹훅 설정에서 발급
                                     #   → 웹훅 수신 URL을 대시보드에 등록: {NEXT_PUBLIC_SITE_URL}/api/payments/webhook
# NEXT_PUBLIC_TOSS_CLIENT_KEY=       # [정석(결제위젯) 전환 시 필수][공개] 브라우저 SDK 초기화. test_ck_.../live_ck_...
                                     #   secretKey와 "한 세트"여야 함. 현행 서버-리다이렉트 방식에선 불필요(docs/08 참고)
